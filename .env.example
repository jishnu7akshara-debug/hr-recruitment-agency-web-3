# Talenty Consultancy - Environment Configuration Template

# 1. Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase Configuration (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Transactional Email Engine (Resend)
# If omitted or left empty, emails are logged to the console in development/demo mode
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Talenty Consultancy <admissions@talenty.in>
STAFF_NOTIFICATION_EMAIL=recruiting@talenty.in

# 4. Storage Bucket
SUPABASE_STORAGE_BUCKET=resumes

